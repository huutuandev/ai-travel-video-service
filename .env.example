# Application and authentication
# Keep loopback for local use. Generate tenant keys of at least 32 characters.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
SERVICE_API_KEYS='{"11111111-1111-4111-8111-111111111111":""}'
MAX_REQUEST_BYTES=262144

# PostgreSQL
# Use a URL-safe password and set the same value in DATABASE_URL.
POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://video:@postgres:5432/video

# Redis and Celery
VIDEO_WORKER_CPUS=4
VIDEO_WORKER_MEMORY=4g
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=2
TASK_SOFT_TIMEOUT=240
TASK_HARD_TIMEOUT=270
MAX_JOB_ATTEMPTS=3
DISPATCH_INTERVAL=5
REDISPATCH_AFTER=600

# Groq AI Director
AI_DIRECTOR_ENABLED=false
AI_DIRECTOR_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_MAX_RETRIES=1
AI_DIRECTOR_FALLBACK_ENABLED=true
AI_DIRECTOR_MAX_SCENES=8

# WaveSpeedAI
# Live submission requires all three provider switches and a job budget.
VIDEO_PROVIDER=wavespeed
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai
WAVESPEED_MODEL=alibaba/wan-2.6/image-to-video-flash
WAVESPEED_ENABLED=false
WAVESPEED_DRY_RUN=true
WAVESPEED_LIVE_TEST_ENABLED=false
WAVESPEED_RESOLUTION=720p
WAVESPEED_DURATION_SECONDS=5
WAVESPEED_GENERATE_AUDIO=false
WAVESPEED_ENABLE_PROMPT_EXPANSION=false
WAVESPEED_MAX_CONCURRENT=2
WAVESPEED_HTTP_TIMEOUT_SECONDS=30
WAVESPEED_POLL_INTERVAL_SECONDS=15
WAVESPEED_TASK_TIMEOUT_SECONDS=900

# DashScope legacy (resume)
# WAN_PRICE_PER_SECOND_USD=0.025
WAN_ENABLED=false
WAN_DRY_RUN=true
WAN_LIVE_TEST_ENABLED=false
WAN_API_KEY=
WAN_BASE_URL=https://dashscope-intl.aliyuncs.com
WAN_MODEL=wan2.6-i2v-flash
WAN_RESOLUTION=720P
WAN_DEFAULT_DURATION=5
WAN_MAX_CONCURRENT_TASKS=2
WAN_POLL_INTERVAL_SECONDS=15
WAN_TASK_TIMEOUT_SECONDS=900
WAN_HTTP_TIMEOUT_SECONDS=15

# Local TTS (CPU)
VIDEO_WORKER_TARGET=runtime
TTS_MODEL_HOST_DIR=./models/tts
# Set VIDEO_WORKER_TARGET=tts-worker when TTS_ENABLED=true.
TTS_ENABLED=false
TTS_PROVIDER=vieneu
TTS_DEVICE=cpu
TTS_OFFLINE_ONLY=true
TTS_MODEL_DIR=/data/models/tts
TTS_VOICE=default
TTS_SPEED=1.0
TTS_MAX_CONCURRENT=1
TTS_TIMEOUT_SECONDS=180

# Audio and media
# Compose fixes MEDIA_ROOT at /data/media. OS temporary files use /tmp.
MAX_ASSET_BYTES=33554432
MAX_JOB_ASSET_BYTES=167772160
MAX_ASSET_DURATION=180
FFMPEG_THREADS=2
SUBTITLE_ENABLED=true
SUBTITLE_FORMAT=ass
AUDIO_DUCKING_ENABLED=true

